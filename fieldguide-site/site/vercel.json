{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.fieldguide.money" }],
      "destination": "https://fieldguide.money/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pulse.theaslangroupllc.com/api/:path*"
    }
  ]
}
